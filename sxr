#
# sxr: set up and maintain the SemanticXR Docker environment. See docs/DOCKER.md.
#
#   ./sxr setup [--registry R] [--models-dir D] [--arch A] [--skip-verify]
#                       one-time machine setup: checks, .env, image, models, self-test
#   ./sxr update        make the image match this checkout's dependencies
#                       (local tag -> registry pull -> local build, first that works)
#   ./sxr build [--arch A] [--no-cache]   build the environment image locally
#   ./sxr push          publish the environment image for this checkout to the registry
#   ./sxr release [--version V] [--push]  image with the code baked in (frozen deploys)
#   ./sxr status        what is configured / built / downloaded
#   ./sxr up|down|logs|verify|shell [args]   shortcuts for docker compose
#
# Day to day you only need:  git pull  &&  docker compose up
#
# Per-machine settings are stored in .env (gitignored), never in the repo:
#   SXR_REGISTRY    registry namespace for images, e.g. registry.example.com/team
#                   (images: $SXR_REGISTRY/semanticxr-env:<fingerprint>, $SXR_REGISTRY/semanticxr:<version>)
#   SXR_MODELS_DIR  where model weights are kept (default ~/.cache/semanticxr/models)
#   SXR_ARCH        GPU archs for local builds (default: all supported; "local" = this GPU)
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT"

ENV_REPO=semanticxr-env          # local name of the environment image
REL_REPO=semanticxr              # local name of release images
DEFAULT_ARCH="8.0;8.6;8.9;9.0;10.0;12.0"
MIN_DRIVER=570                   # CUDA 12.8 needs an R570+ driver
ENV_FILES=(Dockerfile scripts/conda scripts/patches)

log()  { printf '\033[1;32m[sxr]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[sxr]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[sxr]\033[0m %s\n' "$*" >&2; exit 1; }

# --- .env (per-machine, gitignored) -------------------------------------------
touch .env
env_get() { grep -E "^$1=" .env 2>/dev/null | tail -n 1 | cut -d= -f2- || true; }
env_set() {
  if grep -qE "^$1=" .env; then sed -i "s|^$1=.*|$1=$2|" .env; else echo "$1=$2" >> .env; fi
}
# environment variables override .env
REGISTRY="${SXR_REGISTRY:-$(env_get SXR_REGISTRY)}"
REGISTRY="${REGISTRY%/}"
ARCH="${SXR_ARCH:-$(env_get SXR_ARCH)}"

fingerprint() { bash docker/env_hash.sh "$ROOT"; }
have_image()  { docker image inspect "$1" >/dev/null 2>&1; }
label()       { docker image inspect --format "{{ index .Config.Labels \"$2\" }}" "$1" 2>/dev/null || true; }
local_arch()  { nvidia-smi --query-gpu=compute_cap --format=csv,noheader | sort -u | paste -sd';'; }
resolve_arch() { # [arch]
  local a="${1:-${ARCH:-$DEFAULT_ARCH}}"
  [[ "$a" == "local" ]] && a="$(local_arch)"
  echo "$a"
}

# --- image management ---------------------------------------------------------
cmd_build() {
  local arch="" nocache=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --arch) arch="$2"; shift ;;
      --no-cache) nocache=(--no-cache) ;;
      *) die "build: unknown option $1" ;;
    esac; shift
  done
  arch="$(resolve_arch "$arch")"
  local h; h="$(fingerprint)"
  log "building $ENV_REPO:$h for GPU archs $arch (all 6 archs: ~30 min on 8 cores; cached layers are reused)"
  docker build --target env "${nocache[@]}" \
    --build-arg TORCH_CUDA_ARCH_LIST="$arch" \
    --label org.semanticxr.env-hash="$h" --label org.semanticxr.arch="$arch" \
    -t "$ENV_REPO:$h" -t "$ENV_REPO:local" .
  log "built $ENV_REPO:$h (also tagged $ENV_REPO:local)"
}

AUTH_ERR="unauthorized|denied|authentication required|no basic auth|403 Forbidden"
NOTFOUND_ERR="not found|manifest unknown|failed to resolve reference"

registry_pull() { # tag -> 0 pulled, 1 not in registry; dies on auth errors
  local ref="$REGISTRY/$ENV_REPO:$1" out attempt
  log "looking for $ref in the registry"
  for attempt in 1 2 3; do
    if out="$(docker pull "$ref" 2>&1)"; then
      docker tag "$ref" "$ENV_REPO:$1"; log "pulled $ref"; return 0
    fi
    if grep -qiE "$AUTH_ERR" <<<"$out"; then
      die "registry refused access to $ref. Log in first:  docker login ${REGISTRY%%/*}"$'\n'"$out"
    fi
    if grep -qiE "$NOTFOUND_ERR" <<<"$out"; then
      warn "not in registry: $(tail -n 1 <<<"$out")"; return 1
    fi
    # network / timeout: retry; finished layers are not downloaded again
    warn "pull attempt $attempt failed: $(tail -n 1 <<<"$out")"
    [[ "$attempt" -lt 3 ]] && sleep 10
  done
  die "could not pull $ref after 3 attempts (network?). Re-run ./sxr update to resume."
}

registry_push() { # local-ref remote-ref
  local attempt
  docker tag "$1" "$2"
  for attempt in 1 2 3; do
    log "pushing $2 (attempt $attempt)"
    # tee keeps docker's progress visible while capturing it for error checks
    if docker push "$2" 2>&1 | tee /tmp/sxr-push.$$ ; [[ "${PIPESTATUS[0]}" == 0 ]]; then
      rm -f /tmp/sxr-push.$$; return 0
    fi
    if grep -qiE "$AUTH_ERR" /tmp/sxr-push.$$; then
      rm -f /tmp/sxr-push.$$; die "registry refused the push. Log in (with push rights):  docker login ${REGISTRY%%/*}"
    fi
    # large layers occasionally time out; a retry skips layers already pushed
    warn "push attempt $attempt failed; retrying"
    [[ "$attempt" -lt 3 ]] && sleep 10
  done
  rm -f /tmp/sxr-push.$$
  die "push of $2 failed after 3 attempts. Re-run ./sxr push to resume."
}

cmd_update() { # [--arch A] (used only if a local build is needed)
  local h; h="$(fingerprint)"
  if have_image "$ENV_REPO:$h"; then
    log "environment image $ENV_REPO:$h is present"
  elif [[ -n "$REGISTRY" ]] && registry_pull "$h"; then
    :
  else
    [[ -n "$REGISTRY" ]] && warn "building locally instead (publish it afterwards with ./sxr push)"
    [[ -z "$REGISTRY" ]] && log "no registry configured: building locally"
    cmd_build "$@"
  fi
  docker tag "$ENV_REPO:$h" "$ENV_REPO:local"
  log "$ENV_REPO:local -> $h (used by docker compose)"
}

cmd_push() {
  local force=0; [[ "${1:-}" == "--force" ]] && force=1
  [[ -n "$REGISTRY" ]] || die "no registry configured. Use: ./sxr setup --registry <host/namespace>  (or SXR_REGISTRY=...)"
  local h; h="$(fingerprint)"
  have_image "$ENV_REPO:$h" || die "no local image $ENV_REPO:$h; run ./sxr build first"
  if [[ "$force" == 0 ]]; then
    local arch; arch="$(label "$ENV_REPO:$h" org.semanticxr.arch)"
    [[ -z "$arch" || "$arch" == "$DEFAULT_ARCH" ]] || \
      die "$ENV_REPO:$h was built only for '$arch'; machines with other GPUs would pull it and fail. Rebuild with all archs (./sxr build --arch \"$DEFAULT_ARCH\") or use --force."
    if [[ -n "$(git status --porcelain -- "${ENV_FILES[@]}" 2>/dev/null)" ]]; then
      die "uncommitted changes in ${ENV_FILES[*]}: no other checkout can match fingerprint $h. Commit + push them first (or --force)."
    fi
  fi
  registry_push "$ENV_REPO:$h" "$REGISTRY/$ENV_REPO:$h"
  log "published. Other machines on a checkout with fingerprint $h now get it via ./sxr update"
}

cmd_release() {
  local version="" push=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version) version="$2"; shift ;;
      --push) push=1 ;;
      *) die "release: unknown option $1" ;;
    esac; shift
  done
  version="${version:-$(git describe --tags --always --dirty 2>/dev/null || echo dev)}"
  cmd_update
  log "building $REL_REPO:$version (environment $(fingerprint) + this checkout's code)"
  docker build -f docker/Dockerfile.release --build-arg ENV_IMAGE="$ENV_REPO:$(fingerprint)" \
    --label org.semanticxr.version="$version" -t "$REL_REPO:$version" .
  log "built $REL_REPO:$version  (run: docker run --gpus all --shm-size=16g --init -p 50051:50051 -p 50054:50054 -v <models>:/models -v <data>:/data $REL_REPO:$version)"
  if [[ "$push" == 1 ]]; then
    [[ -n "$REGISTRY" ]] || die "no registry configured"
    registry_push "$REL_REPO:$version" "$REGISTRY/$REL_REPO:$version"
  fi
}

# --- setup ----------------------------------------------------------------------
preflight() {
  command -v docker >/dev/null || die "Docker is not installed: https://docs.docker.com/engine/install/"
  docker info >/dev/null 2>&1 || die "cannot talk to the Docker daemon. Is it running? Is $USER in the docker group?  sudo usermod -aG docker $USER  (then log out and back in)"
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is missing: https://docs.docker.com/compose/install/linux/"
  command -v nvidia-smi >/dev/null || die "nvidia-smi not found: install the NVIDIA driver (R$MIN_DRIVER or newer)"
  local drv; drv="$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -n 1)"
  [[ "${drv%%.*}" -ge "$MIN_DRIVER" ]] || die "NVIDIA driver $drv is too old for CUDA 12.8; need R$MIN_DRIVER or newer"
  log "GPU: $(nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader | head -n 1), driver $drv"
  if ! docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q nvidia && ! command -v nvidia-ctk >/dev/null; then
    die "NVIDIA Container Toolkit not found (lets containers use the GPU): https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html"
  fi
  local root free
  root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || echo /var/lib/docker)"
  free="$(df -BG --output=avail "$root" 2>/dev/null | tail -n 1 | tr -dc 0-9 || echo 0)"
  [[ "${free:-0}" -ge 40 ]] || warn "only ${free} GB free for Docker ($root); the image + build cache need ~40 GB"
}

cmd_setup() {
  local models="" arch="" verify=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --registry) REGISTRY="${2%/}"; shift ;;
      --models-dir) models="$2"; shift ;;
      --arch) arch="$2"; shift ;;
      --skip-verify) verify=0 ;;
      *) die "setup: unknown option $1" ;;
    esac; shift
  done
  preflight
  models="${models:-$(env_get SXR_MODELS_DIR)}"
  models="${models:-${XDG_CACHE_HOME:-$HOME/.cache}/semanticxr/models}"
  mkdir -p "$models"; models="$(cd "$models" && pwd)"
  env_set SXR_MODELS_DIR "$models"
  [[ -n "$REGISTRY" ]] && env_set SXR_REGISTRY "$REGISTRY"
  [[ -n "$arch" ]] && { env_set SXR_ARCH "$arch"; ARCH="$arch"; }
  log "settings saved to .env (SXR_MODELS_DIR=$models${REGISTRY:+, SXR_REGISTRY=$REGISTRY})"
  local free; free="$(df -BG --output=avail "$models" | tail -n 1 | tr -dc 0-9)"
  [[ "$free" -ge 20 ]] || warn "only ${free} GB free in $models; the models need ~14 GB"

  cmd_update
  log "downloading models into $models (first time: ~14 GB)"
  docker compose run --rm semanticxr fetch-models
  if [[ "$verify" == 1 ]]; then
    log "self-test"
    docker compose run --rm semanticxr verify
  fi
  log "setup complete. Start the server with:  docker compose up"
}

cmd_status() {
  local h; h="$(fingerprint)"
  echo "checkout      : $ROOT ($(git rev-parse --abbrev-ref HEAD 2>/dev/null) @ $(git rev-parse --short HEAD 2>/dev/null))"
  echo "fingerprint   : $h (needs image $ENV_REPO:$h)"
  if have_image "$ENV_REPO:$h"; then echo "image         : present, archs $(label "$ENV_REPO:$h" org.semanticxr.arch)"
  else echo "image         : MISSING -> ./sxr update"; fi
  if have_image "$ENV_REPO:local"; then
    local cur; cur="$(label "$ENV_REPO:local" org.semanticxr.env-hash)"
    echo "compose uses  : $ENV_REPO:local -> ${cur:-unknown}$([[ "$cur" == "$h" ]] && echo " (matches)" || echo " (MISMATCH -> ./sxr update)")"
  fi
  echo "registry      : ${REGISTRY:-<none>}"
  local m; m="$(env_get SXR_MODELS_DIR)"
  echo "models dir    : ${m:-<not set; run ./sxr setup>} $( [[ -n "$m" && -d "$m" ]] && du -sh "$m" 2>/dev/null | cut -f1)"
}

# --- dispatch -------------------------------------------------------------------
cmd="${1:-help}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  setup)   cmd_setup "$@" ;;
  update)  cmd_update "$@" ;;
  build)   cmd_build "$@" ;;
  push)    cmd_push "$@" ;;
  release) cmd_release "$@" ;;
  status)  cmd_status ;;
  up)      have_image "$ENV_REPO:$(fingerprint)" || cmd_update; docker compose up "$@" ;;
  down)    docker compose down "$@" ;;
  logs)    docker compose logs -f "$@" ;;
  verify)  docker compose run --rm semanticxr verify "$@" ;;
  shell)   docker compose run --rm semanticxr bash ;;
  help|-h|--help) sed -n '5,24p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$cmd' (./sxr help)" ;;
esac
