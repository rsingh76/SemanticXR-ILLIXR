# NOTE: directory patterns below are anchored with a leading "/" so they match
# only at the repo root. Unanchored patterns match at ANY depth, which
# previously hid 14 tracked files (slam/datasets/*, tests/*, .vscode/settings.json)
# and silently swallowed anything newly added there.

*.log
*.xcodeproj
.DS_Store
/.dazel_run
/bazel-*
/settings.json
*.pyc
__pycache__/
*__pycache__/
/external/
yolov8l-world.pt
IMPORT_REFACTORING_SUMMARY.md
code_quality_recommendations.md
server/xr_service_pb2.py
server/xr_service_pb2.pyi
server/xr_service_pb2_grpc.py
slam/protocols/vis_proto/vis_pb2.py
slam/protocols/vis_proto/vis_pb2.pyi
slam/protocols/vis_proto/vis_pb2_grpc.py
config/production.yaml
*.egg-info/

# Runtime artifacts (don't track generated data)
logs_performance/
/datasets/
debug_dumps/
server/debug_dumps/

# Generated gRPC protobuf stubs (regenerated by scripts/setup_env.sh)
slam/protocols/vis_proto/vis_pb2.py
slam/protocols/vis_proto/vis_pb2_grpc.py
server/xr_service_pb2.py
server/xr_service_pb2_grpc.py

# Generated visualization images (scripts/visualize_e2e.py)
/outputs/

# Default docker-compose volume root (models + run data, see docs/DOCKER.md)
/docker-volumes/

# Per-machine Docker settings written by ./sxr setup (may contain a private registry path)
.env
# Organisation-internal notes (e.g. private registry instructions); never committed
/internal/

# Run outputs / scratch written into the checkout by native and Docker runs
/live_output/
/output/
/main_server/
slam/services/output_audio.wav
